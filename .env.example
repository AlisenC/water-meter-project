# Backend
# PostgreSQL connection string. Never commit the real value (this file is
# the template; the actual DATABASE_URL lives in a gitignored .env).
DATABASE_URL=postgresql+psycopg://user:password@host:5432/water_meter

# Dedicated test database (see backend/tests/conftest.py) — required to run
# the backend test suite. Point this at a database that holds no real data;
# every test run truncates all app tables in it.
TEST_DATABASE_URL=postgresql+psycopg://user:password@host:5432/water_meter_test

ALLOWED_ORIGINS=http://localhost

# Local-model (Ollama) fallback for PDF billing import.
# Used automatically when a /import-billing request has no X-Api-Key header.
# `docker compose up` runs Ollama as its own service and pulls this model
# automatically. For non-Docker local dev, run `ollama serve` and
# `ollama pull llama3.1` yourself — the backend's built-in default already
# points at http://localhost:11434, so OLLAMA_BASE_URL only needs to be set
# if Ollama runs somewhere else.
OLLAMA_MODEL=llama3.1

# Frontend (build-time)
VITE_API_URL=http://localhost:8000
